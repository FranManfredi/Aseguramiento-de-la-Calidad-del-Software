classDiagram
    class Product {
        +String name
        +String description
    }

    class Cart {
        -List~Product~ cart
        +addToCart(product: Product)
        +addToCart(products: List~Product~)
        +removeFromCart(product: Product)
        +removeAllFromCart()
        +removeAllFromCart(product: Product)
        +isEmpty() : Boolean
        +getNumberOfProducts() : Int
    }

    Cart --> Product : contains
